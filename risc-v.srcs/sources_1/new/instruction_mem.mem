// ============================================================
// BRANCH PREDICTOR STRESS TEST PROGRAM
// Tests:
// 1. Cold misses
// 2. BTB training
// 3. 2-bit BPB hysteresis
// 4. Alternating branches
// 5. Nested branches
// 6. BTB aliasing
// 7. Taken/not-taken recovery
// ============================================================

// ============================================================
// PHASE 1 : SIMPLE TAKEN BRANCH
// Expect:
// - first miss
// - second correct prediction
// ============================================================

00500093  // 0x000 : ADDI x1, x0, 5
00500113  // 0x004 : ADDI x2, x0, 5
00208463  // 0x008 : BEQ  x1, x2, +8 -> 0x010 TAKEN
00000013  // 0x00C : NOP (flush expected first time)
00100193  // 0x010 : ADDI x3, x0, 1

// repeat same branch
00208463  // 0x014 : BEQ  x1, x2, +8 -> 0x01C TAKEN
00000013  // 0x018 : NOP
00200193  // 0x01C : ADDI x3, x0, 2


// ============================================================
// PHASE 2 : LOOP TRAINING
// Expect:
// - BPB converges to strongly taken
// - final loop exit mispredict only once
// ============================================================

00500213  // 0x020 : ADDI x4, x0, 5

00120213  // 0x024 : ADDI x4, x4, -1
FE021EE3  // 0x028 : BNE  x4, x0, -4 -> 0x024
00000013  // 0x02C : NOP


// ============================================================
// PHASE 3 : ALTERNATING BRANCH
// 2-bit predictor should perform better than 1-bit
// ============================================================

00000293  // 0x030 : ADDI x5, x0, 0

// iteration 1
00028663  // 0x034 : BEQ x5, x0, +12 TAKEN
00000013  // 0x038 : NOP
00100293  // 0x03C : ADDI x5, x0, 1

// iteration 2
00028663  // 0x040 : BEQ x5, x0, +12 NOT TAKEN
00000013  // 0x044 : NOP
00000293  // 0x048 : ADDI x5, x0, 0

// iteration 3
00028663  // 0x04C : BEQ x5, x0, +12 TAKEN
00000013  // 0x050 : NOP
00100293  // 0x054 : ADDI x5, x0, 1


// ============================================================
// PHASE 4 : BTB TARGET VALIDATION
// Different targets
// ============================================================

00500313  // 0x058 : ADDI x6, x0, 5
00300393  // 0x05C : ADDI x7, x0, 3

00734463  // 0x060 : BLT x6, x7, +8 NOT TAKEN
00000013  // 0x064 : NOP

0063D463  // 0x068 : BGE x7, x6, +8 NOT TAKEN
00000013  // 0x06C : NOP

00735463  // 0x070 : BGE x6, x7, +8 TAKEN
00000013  // 0x074 : NOP
00000013  // 0x078 : NOP


// ============================================================
// PHASE 5 : NESTED BRANCHES
// Tests flush interaction
// ============================================================

00500413  // 0x07C : ADDI x8, x0, 5
00500493  // 0x080 : ADDI x9, x0, 5

00940463  // 0x084 : BEQ x8, x9, +8 TAKEN
00000013  // 0x088 : NOP

00941463  // 0x08C : BNE x8, x9, +8 NOT TAKEN
00000013  // 0x090 : NOP


// ============================================================
// PHASE 6 : BTB ALIASING TEST
// PCs map to same index [5:2]
// ============================================================

// 0x094 -> index 5
00100513  // 0x094 : ADDI x10, x0, 1
00050663  // 0x098 : BEQ x10, x0, +12 NOT TAKEN
00000013  // 0x09C : NOP

// 0x0D4 -> same index 5
00100593  // 0x0A0 : ADDI x11, x0, 1
00058663  // 0x0A4 : BEQ x11, x0, +12 NOT TAKEN
00000013  // 0x0A8 : NOP


// ============================================================
// PIPELINE DRAIN
// ============================================================

00000013  // 0x0AC : NOP
00000013  // 0x0B0 : NOP
00000013  // 0x0B4 : NOP
00000013  // 0x0B8 : NOP
00000013  // 0x0BC : NOP